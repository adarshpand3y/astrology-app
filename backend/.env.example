# Copy to .env and adjust. Settings module: astrology.settings.dev (manage.py default)
# or astrology.settings.prod (wsgi/asgi default).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: SQLite by default; switch to Postgres later with e.g.
# DATABASE_URL=postgres://user:pass@host:5432/astrology
DATABASE_URL=sqlite:///db.sqlite3

# Cache used by rate limiting. Use Redis in production with multiple workers:
# CACHE_URL=redis://localhost:6379/1
CACHE_URL=locmemcache://

# Data files (ephemeris + GeoNames). Defaults to ./data
# DATA_DIR=/srv/astrology/data
# EPHEMERIS_PATH=/srv/astrology/data

# CORS (only needed for browser clients; native mobile apps don't need it)
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Email: console in dev, Nitrosend API in prod. EMAIL_BACKEND = console | nitrosend | smtp
# (set EMAIL_BACKEND=nitrosend in dev to send real emails)
# EMAIL_BACKEND=nitrosend
# Dashboard → Settings → API Keys (app.nitrosend.com/my/settings/api-keys).
# Use the secret key (nskey_…); the public key isn't needed to send from the server.
NITROSEND_API_KEY=
NITROSEND_API_URL=https://api.nitrosend.com/v1/my
# Seconds to wait for Nitrosend (one retry on timeout, same idempotency key)
NITROSEND_TIMEOUT=20
# Must be a verified sender identity in Nitrosend
DEFAULT_FROM_EMAIL=Astrology <no-reply@example.com>
# Branding in emails (match frontend/brand.config.js)
# APP_NAME=Guru Drishti
# APP_TAGLINE=Vedic daily companion
# EMAIL_ACCENT_COLOR=#B0722F
# Only used with EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Oldest app version the API accepts (X-App-Version header); older or missing -> 426 "update required".
# Leave empty to turn the check off. The platform-specific values override MIN_APP_VERSION.
MIN_APP_VERSION=
# MIN_APP_VERSION_ANDROID=1.0.0
# MIN_APP_VERSION_IOS=1.0.0

# Emails to free users linking to the website checkout (sent by the server, never shown in the app).
# Empty PREMIUM_CHECKOUT_URL = no emails. {email} in the link is replaced with the user's email.
PREMIUM_CHECKOUT_URL=
# PREMIUM_CHECKOUT_URL=https://pages.razorpay.com/your-page?email={email}
# Days after signup for each email (0 = when the account is verified). Run `manage.py send_premium_emails` hourly.
PREMIUM_EMAIL_DAYS=0,3,7
# Public address of this server, for unsubscribe links
PUBLIC_BASE_URL=https://api.example.com

# Website payments via Razorpay. Dashboard -> Webhooks: URL https://<api>/api/v1/billing/webhooks/razorpay/,
# events payment.captured + refund.processed, and this secret. Empty = webhook off.
RAZORPAY_WEBHOOK_SECRET=
# Amount in paise -> Pro days. Default: PRO_PRICE_MONTHLY -> 30 days, PRO_PRICE_ANNUAL -> 365 days.
# RAZORPAY_PLANS=29900:30,249900:365

# Auth
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
REQUIRE_EMAIL_VERIFICATION=True
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Rate limits
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_AUTH=10/min
THROTTLE_OTP=5/min
THROTTLE_COMPUTE=60/min

# Template test UI at /ui/ (on by default in dev, off in prod)
ENABLE_TEST_UI=True
LOG_LEVEL=INFO
